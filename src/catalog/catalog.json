    {
      "id": "test-questions",
      "title": "Questions to ask about a test",
      "summary": "Ask what a test is for, how to prepare and how to follow up on results.",
      "category": "Care & medicines",
      "topics": [
        "visit-preparation",
        "healthcare-visit"
      ],
      "body": [
        {
          "type": "heading",
          "text": "Questions for your care team"
        },
        {
          "type": "list",
          "items": [
            "What is this test for?",
            "Does the facility have preparation instructions? Who can explain them to me?",
            "When should I expect the results, and how will I receive them?",
            "Which person or office should I contact if the results have not arrived by then?"
          ]
        },
        {
          "type": "paragraph",
          "text": "Ask your care team to explain anything unclear. Check the facility’s own instructions for your test and ask the team what your results mean."
        }
      ],
      "sources": [
        {
          "publisher": "Agency for Healthcare Research and Quality (AHRQ)",
          "title": "Be More Engaged in Your Healthcare",
          "url": "https://www.ahrq.gov/questions/be-engaged/index.html",
          "checkedAt": "2026-11-13"
        },
        {
