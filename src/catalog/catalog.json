  "guides": [
    {
      "id": "prepare-visit",
      "title": "Prepare for a healthcare visit",
      "summary": "Choose your main questions and gather what you want to discuss with the care team.",
      "category": "Care & medicines",
      "topics": [
        "visit-preparation",
        "healthcare-visit"
      ],
      "body": [
        {
          "heading": "Choose what matters most",
          "text": "Pick the questions you most want answered. Bring a short list so you can refer to it during the visit."
        },
        {
          "heading": "Make a note of your concerns",
          "text": "If you have a concern, note when it started and what you want the care team to know. Bring those notes with you."
        },
        {
          "heading": "Bring your medicines list",
          "text": "Bring a list of medicines, vitamins, herbal products and other supplements you take, along with any known allergies, to discuss with the care team."
        },
        {
          "heading": "Check with the facility",
          "text": "Check the facility’s appointment instructions. Ask its staff if anything is unclear or you need help preparing."
        }
      ],
      "sources": [
        {
          "publisher": "MedlinePlus · U.S. National Library of Medicine",
          "title": "Talking With Your Doctor",
          "url": "https://medlineplus.gov/talkingwithyourdoctor.html",
          "checkedAt": "2026-11-13"
        },
        {
          "publisher": "NHS",
          "title": "Outpatients and day patients",
          "url": "https://www.nhs.uk/nhs-services/hospitals/going-into-hospital/outpatients-and-day-patients/",
          "checkedAt": "2026-11-13"
        }
      ],
