    {
      "id": "before-you-leave",
      "title": "Before you leave your appointment",
      "summary": "Confirm the next step, its timing and who can answer follow-up questions.",
      "category": "Care & medicines",
      "topics": [
        "visit-preparation",
        "healthcare-visit"
      ],
      "body": [
        {
          "heading": "Check the next step",
          "text": "Ask what should happen next and when. Check whether you need to arrange another appointment or test, and who will arrange it."
        },
        {
          "heading": "Ask for instructions you can take away",
          "text": "Ask for written instructions where available. Check your understanding with the care team and ask them to explain anything unclear."
        },
        {
          "heading": "Know who to contact",
          "text": "Ask which number or office to use if you have questions after leaving. If a test was discussed, confirm how and when to get the results and whom to contact if they are delayed."
        }
      ],
      "sources": [
        {
